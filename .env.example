# ── TruckerTools ──────────────────────────────────────────
# Add these in Vercel → Project → Settings → Environment Variables
TT_PARTNER_ID=152
TT_ACCOUNT_ID=7jlmaLrkj5eq4NN/PHa9uQ==

# ── Google Maps (optional — for the route map) ────────────
# Get a free Maps Embed API key at console.cloud.google.com
# Restrict it to your domain: ship.paragongl.com
NEXT_PUBLIC_GOOGLE_MAPS_KEY=YOUR_GOOGLE_MAPS_KEY_HERE

# ── Supabase (shared project with Nexus — for stop cards) ──
# Same project Nexus writes to. Read-only use, server-side only.
# SUPABASE_URL: Project Settings → API → Project URL
# Prefer the SERVICE ROLE key (server-side, bypasses RLS — never exposed to the
# browser). If you use the anon key instead, grant select on tracking_stops_view
# to the anon role first. If these are left unset, the page still works — it just
# won't show stop cards.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE
